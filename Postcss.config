module.exports = {
  plugins: {
    "postcss-pxtorem": {
      rootValue: 16, // matches default browser font-size — don't change unless you also set html { font-size } to something else
      propList: ["*"], // convert every property: padding, margin, font-size, gap, etc.
      unitPrecision: 5,
      minPixelValue: 2, // leaves 1px borders/hairlines as px — rem-ing those causes subpixel rendering issues
    },
  },
};
